# ===================== CppMind .gitignore =====================
# 本文件确保密钥、本地环境、构建产物与发布二进制不进入仓库。

# ---------- 密钥 / 环境变量（最高优先级，绝不入库）----------
server/.env
.env
.env.*
*.env

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
.mypy_cache/
.ruff_cache/
.pytest_cache/
.idea/
.vscode/

# ---------- 构建产物 / 发布二进制 ----------
build/
dist/
*.exe
*.apk
*.aab
*.app
release/
dist_*/

# ---------- 工具 / 临时 / 沙箱目录 ----------
# 临时检索与注入脚本（含草稿，不应入库）
scratch/
# 工作区记忆（本机专属，跨机器无意义）
.workbuddy/
# 本机构建/缓存目录（曾出现）
.exbuild/
.tmp_node/

# ---------- 内容校验中间产物 ----------
content/_coverage.json
content/_learning_lines.json

# ---------- OS / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 前端（Tauri v2 + Vite + React/TS） ----------
frontend/node_modules/
frontend/.vite/
frontend/npm-debug.log*
frontend/yarn-error.log*
# package-lock.json **要入库**（锁定依赖版本，保证 CI/协作可复现）

# ---------- Tauri v2 本机构建产物 ----------
src-tauri/target/
src-tauri/gen/android/app/build/
src-tauri/gen/android/build/
src-tauri/gen/android/app/src/main/libs/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/local.properties
*.keystore
*.jks

# ---------- Flutter / Dart ----------
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/android/.gradle/
app/ios/Flutter/Flutter.framework/
app/ios/Flutter/Flutter.podspec
app/linux/build/
app/macos/build/
app/windows/build/
app/web/build/
*.iml

# ---------- Docker / 运行时数据 ----------
*.log
pgdata/
redisdata/
miniodata/

# 交付暂存（本地 APK/EXE 暂存，不入库）
dist-release/
deploy/launcher/build-new/
deploy/launcher/dist-new/

# ---------- 前端验收截图（shot.mjs 产出，本地看，不入库）----------
frontend/.shots/

# ---------- 内容审计与备份（脚本可再生，不入库）----------
content/_backup_*/
content/_depth_audit.json
content/_depth_audit.md
content/_standards_audit.json
content/_standards_audit.md
content/_correctness_full.txt
content/_correctness_warn.txt

# ---------- 本地草稿 / 技能缓存 / 临时目录 ----------
.scratch/
.taste-skill/
frontend/.scratch/
server/.scratch/
web-preview/.taste-skill/
tmp/
scripts/_ai11_out/
scripts/_chparts/

# ---------- Vite 临时时间戳配置副本 ----------
frontend/vite.config.ts.timestamp-*.mjs

# ---------- Tauri 生成的平台工程（gen/schemas、gen/android）----------
src-tauri/gen/


# 概念图解数据（由 scripts/gen_concept_viz.py 生成，不入库）
viz/data.js

# ---------- 审计实跑示例时由 cpp-ch13 fstream 示例写出的临时文件 ----------
/demo_bin.bin
/demo_text.txt
/nums.txt

# ---------- 双端原生封装的制备产物（deploy/package/prepare.py 生成，不入库）----------
deploy/package/desktop/
deploy/package/mobile/
