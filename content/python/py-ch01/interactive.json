          "label": "片段数 n",
          "expr": "n",
          "unit": "段",
          "fmt": "int"
        },
        {
          "key": "outKB",
          "label": "结果字符串",
          "expr": "n * 20 / 1024",
          "unit": "KB",
          "fmt": "int"
        },
        {
