      "questions": [
        {
          "id": "q0",
          "stem": "某机指令字长 16 位，每个地址码字段固定 4 位。采用扩展操作码设计零/一/二/三地址指令。若已设计 15 条三地址、15 条二地址、15 条一地址指令，则零地址指令最多可设计多少条？",
          "title": "扩展操作码方案判断",
          "options": [
            {
              "key": "A",
              "text": "15 条"
            },
            {
              "key": "B",
              "text": "16 条"
            },
            {
              "key": "C",
              "text": "31 条"
            },
            {
              "key": "D",
              "text": "32 条"
            }
          ],
          "correct": [
            "B"
          ],
          "explain": "指令字长 16 位，4 位一段。三地址用 0000~1110（15 条），保留 1111；二地址用 1111 0000~1111 1110（15 条），保留 1111 1111；一地址用 1111 1111 0000~1111 1111 1110（15 条），保留 1111 1111 1111；零地址用剩余的 16 个 16 位码点（1111 1111 1111 0000~1111 1111 1111 1111）。故零地址最多 16 条。"
        },
        {
          "id": "q1",
          "stem": "采用一次间接寻址取得一个操作数，假设取指令已单独计算，仅考虑取该操作数，共需访问主存多少次？",
          "title": "寻址方式访存次数",
          "options": [
            {
              "key": "A",
              "text": "0 次"
            },
            {
              "key": "B",
              "text": "1 次"
            },
            {
              "key": "C",
              "text": "2 次"
            },
            {
              "key": "D",
              "text": "3 次"
            }
          ],
          "correct": [
            "C"
          ],
          "explain": "一次间接寻址：先用形式地址 A 访存一次取出操作数地址（EA=M[A]），再用 EA 访存一次取出操作数本身，共 2 次访存。寄存器访问不计入主存访问。"
        },
        {
          "id": "q2",
          "stem": "关于基址寻址与变址寻址，下列说法正确的是？",
          "title": "基址与变址寻址辨析",
          "options": [
            {
              "key": "A",
              "text": "基址寄存器和变址寄存器的内容都由程序员随时改变"
            },
            {
              "key": "B",
              "text": "基址寻址中基址寄存器内容固定、位移可变，主要用于程序重定位"
            },
            {
              "key": "C",
              "text": "变址寻址中位移可变、变址寄存器内容固定，主要用于程序重定位"
            },
            {
              "key": "D",
              "text": "基址寻址的访存次数一定多于变址寻址"
            }
          ],
          "correct": [
            "B"
          ],
          "explain": "基址寻址：基址寄存器内容固定（由 OS 设定，用于重定位），位移可变；变址寻址：变址寄存器内容可变（用于数组遍历），位移固定。二者 EA 都只需 1 次访存，访存次数相同。"
        }
